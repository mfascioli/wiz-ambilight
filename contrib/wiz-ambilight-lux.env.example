# Copy this file to ~/.config/wiz-ambilight/lux.env and adjust it.
# Read by contrib/wiz-ambilight-lux.service.

# Shared secret the ESP32 sends in the X-Lux-Token header. Leave empty to
# accept any sender on the LAN (the reading can only change Equalize's
# brightness, but a token keeps accidental posts out).
WIZ_LUX_TOKEN=change-me

# Optional: move the bridge off 8766.
# WIZ_LUX_PORT=8766
