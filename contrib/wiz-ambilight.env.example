# Copy this file to ~/.config/wiz-ambilight/env and adjust the IPs.
# Pin the bulbs you want to use (otherwise they are auto-discovered):
WIZ_LIGHTS=192.168.1.5,192.168.1.7

# To use another style, edit the systemd unit's ExecStart, for example:
#   ExecStart=%h/.local/bin/mpv-ambilight --attach --style cinema
